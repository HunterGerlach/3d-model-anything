<?xml version="1.0" encoding="utf-8"?>
<!-- Some Android 12+ devices allow D2D transfer despite allowBackup=false. Exclude captures explicitly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
